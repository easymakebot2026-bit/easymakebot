# Copy to .env.bot and fill in. Never commit .env.bot.
# Consumed by deploy/docker-compose.bot.yml + bot/config.py.

# ── Telegram ─────────────────────────────────────────────────────────
# Token for @easymakebot itself (from @BotFather), NOT a user's built bot.
BOT_TOKEN=
# Your numeric Telegram ID (message @userinfobot). The only full-admin account.
PLATFORM_ADMIN_ID=

# ── Encryption ───────────────────────────────────────────────────────
# Encrypts bot tokens / phone numbers / payment creds at rest. Generate once:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If this is ever lost, every encrypted column becomes unreadable — back it up.
# To rotate the key later without losing access to old data, set this to
# "new_key,old_key" (comma-separated, new key first) until every row has
# been re-saved, then drop the old key.
ENCRYPTION_KEY=

# ── Database ─────────────────────────────────────────────────────────
# These three create the bot-db Postgres container. DATABASE_URL is built
# from them automatically in docker-compose.bot.yml — don't set it here.
POSTGRES_DB=easymakebot
POSTGRES_USER=easymakebot
POSTGRES_PASSWORD=

# ── This server's public HTTPS host (Caddy terminates TLS for it) ────
# The Mini App + payment callbacks live here. Point its DNS A record at THIS
# server. WEBAPP_PORT is forced to 8080 by the compose file.
APP_DOMAIN=app.easymakebot.com
WEBAPP_URL=https://app.easymakebot.com
CADDY_EMAIL=you@example.com

# ── Marketing website (in Iran) — plan purchase + activation codes ───
# An owner buys a plan on the site (native Iran IP, no Telegram VPN), gets an
# EMB-XXXX-XXXX code, and redeems it here in /live. The bot only ever calls
# the site's REST API (via Cloudflare) to redeem — it never handles the payment.
# WEBSITE_ACTIVATION_KEY MUST equal EMB_ACTIVATION_KEY in the site's web/.env.
WEBSITE_URL=https://easymakebot.com
WEBSITE_ACTIVATION_KEY=
# Where Iran owners are sent to buy (opens in their browser). Defaults to
# {WEBSITE_URL}/plans/ if left blank.
WEBSITE_PLANS_URL=

# ── Optional: video guide links shown on /start ─────────────────────
VIDEO_URL_FA=
VIDEO_URL_EN=

# ── Optional: the PLATFORM's own payment creds for /live plans ──────
# International owners see TON / Stripe (IP-agnostic). Iran owners are sent to
# the website instead unless PLATFORM_ONBOT_ZARINPAL=true AND ZARINPAL_PROXY_URL
# (below) is set — without the proxy, a foreign server + the buyer's Telegram
# VPN both break the Zarinpal gateway, so only set PLATFORM_ONBOT_ZARINPAL=true
# with no proxy if this bot server is itself on an Iran IP.
PLATFORM_ONBOT_ZARINPAL=false
PLATFORM_ZARINPAL_MERCHANT_ID=
PLATFORM_STRIPE_SECRET_KEY=
PLATFORM_TON_WALLET_ADDRESS=

# ── Optional: route Zarinpal calls through the Iran website server ──
# Fixes the foreign-IP problem above for BOTH the platform's /live plans and
# every built bot's own shop (bot/shop.py) — set once, benefits both money
# flows, since they share the same Zarinpal request/verify code.
# ZARINPAL_PROXY_URL = {WEBSITE_URL}/wp-json/emb/v1/zarinpal (mu-plugin
# emb-zarinpal-proxy.php, deployed on the Iran server alongside
# emb-activation-codes.php). ZARINPAL_PROXY_KEY MUST equal
# EMB_ZARINPAL_PROXY_KEY in the site's web/.env.
ZARINPAL_PROXY_URL=
ZARINPAL_PROXY_KEY=

# ── Optional: identity verification gate for /live (Zarinpal + TON) ──────
# Before a first Zarinpal (Iran) or TON (international) plan payment, the
# owner needs a verified account on the website (same check the website
# itself uses to gate plan purchases there). If they never visited the
# website, /live collects the same registration fields right in the bot
# (name/last/phone/address/email + SMS code for Iran; email + email code for
# international) via mu-plugin emb-bot-verify.php, then lets them pay.
# Leave WEBSITE_VERIFY_KEY empty to skip this gate entirely — existing
# behavior is unaffected either way.
# WEBSITE_VERIFY_KEY = {WEBSITE_URL}, key MUST equal EMB_BOT_VERIFY_KEY in
# the site's web/.env. Separate key from WEBSITE_ACTIVATION_KEY /
# ZARINPAL_PROXY_KEY (least privilege — each bridge has its own).
WEBSITE_VERIFY_KEY=
