# Copy to .env.bot and fill in. Never commit .env.bot.
# Consumed by deploy/docker-compose.bot.yml + bot/config.py.

# ── Telegram ─────────────────────────────────────────────────────────
# Token for @easymakebot itself (from @BotFather), NOT a user's built bot.
BOT_TOKEN=
# Your numeric Telegram ID (message @userinfobot). The only full-admin account.
PLATFORM_ADMIN_ID=

# ── Encryption ───────────────────────────────────────────────────────
# Encrypts bot tokens / phone numbers / payment creds at rest. Generate once:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If this is ever lost, every encrypted column becomes unreadable — back it up.
ENCRYPTION_KEY=

# ── Database ─────────────────────────────────────────────────────────
# These three create the bot-db Postgres container. DATABASE_URL is built
# from them automatically in docker-compose.bot.yml — don't set it here.
POSTGRES_DB=easymakebot
POSTGRES_USER=easymakebot
POSTGRES_PASSWORD=

# ── This server's public HTTPS host (Caddy terminates TLS for it) ────
# The Mini App + payment callbacks live here. Point its DNS A record at THIS
# server. WEBAPP_PORT is forced to 8080 by the compose file.
APP_DOMAIN=app.easymakebot.com
WEBAPP_URL=https://app.easymakebot.com
CADDY_EMAIL=you@example.com

# ── Marketing website (in Iran) — plan purchase + activation codes ───
# An owner buys a plan on the site (native Iran IP, no Telegram VPN), gets an
# EMB-XXXX-XXXX code, and redeems it here in /live. The bot only ever calls
# the site's REST API (via Cloudflare) to redeem — it never handles the payment.
# WEBSITE_ACTIVATION_KEY MUST equal EMB_ACTIVATION_KEY in the site's web/.env.
WEBSITE_URL=https://easymakebot.com
WEBSITE_ACTIVATION_KEY=
# Where Iran owners are sent to buy (opens in their browser). Defaults to
# {WEBSITE_URL}/plans/ if left blank.
WEBSITE_PLANS_URL=

# ── Optional: video guide links shown on /start ─────────────────────
VIDEO_URL_FA=
VIDEO_URL_EN=

# ── Optional: the PLATFORM's own payment creds for /live plans ──────
# International owners see TON / Stripe (IP-agnostic). Iran owners are sent to
# the website instead — do NOT set PLATFORM_ONBOT_ZARINPAL=true unless this
# bot server is itself on an Iran IP (a foreign server + the buyer's Telegram
# VPN both break the Zarinpal gateway).
PLATFORM_ONBOT_ZARINPAL=false
PLATFORM_ZARINPAL_MERCHANT_ID=
PLATFORM_STRIPE_SECRET_KEY=
PLATFORM_TON_WALLET_ADDRESS=
