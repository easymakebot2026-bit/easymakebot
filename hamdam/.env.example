# Copy to .env (never commit it). One file per node.
# Example values below are for the Iran node; the global node is shown in comments.

# ── Identity ─────────────────────────────────────────────────────────
NODE_ID=ir                                   # global node: NODE_ID=global
DATABASE_URL=postgresql+asyncpg://hamdam:password@localhost:5432/hamdam
PUBLIC_URL=https://ir.hamdam.example         # this node's public HTTPS URL
PORT=8090
DEFAULT_TZ=Asia/Tehran

# ── The other node(s) ─────────────────────────────────────────────────
# Leave PEERS empty to run a single standalone node.
PEERS=global=https://app.hamdam.example      # global node: PEERS=ir=https://ir.hamdam.example
# Same long random secret on every node:  python -c "import secrets;print(secrets.token_hex(32))"
PEER_KEY=
NODE_LABELS=ir=Iran|ایران,global=Outside Iran|خارج از ایران

# ── Messengers ───────────────────────────────────────────────────────
# Iran node: a Bale bot (from @botfather inside Bale). Global node: a Telegram bot.
BALE_BOT_TOKEN=
TELEGRAM_BOT_TOKEN=
# Which bot elders on THIS node use. Defaults to the first configured bot.
ELDER_CHANNEL=bale                           # global node: ELDER_CHANNEL=telegram

# ── Domestic SMS (Kavenegar) — Iran node only ─────────────────────────
SMS_API_KEY=
SMS_SENDER=

# ── Payments: the payer's node decides the method ─────────────────────
# Iran node: Zarinpal (Toman). Global node: TON (USD equivalent, manual review).
ZARINPAL_MERCHANT_ID=
TON_WALLET_ADDRESS=
PRICE_TOMAN_MONTH=990000
PRICE_USD_MONTH=12
TRIAL_DAYS=7

# Who approves TON payments (numeric chat id on ADMIN_CHANNEL).
ADMIN_CHANNEL=bale                           # global node: telegram
ADMIN_CHAT_ID=
