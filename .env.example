# Token you got from BotFather (for easymakebot itself, not the users' bots)
BOT_TOKEN=1234567890:AAExampleTokenHere

# Database connection URL (needed for the next step, can be left empty for now)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/easymakebot

# Your numeric Telegram ID, the only one with full platform admin access
# (message @userinfobot on Telegram to get it)
PLATFORM_ADMIN_ID=123456789

# Encryption key (generate it with the command in the README)
ENCRYPTION_KEY=

# Public HTTPS base URL where the Mini App (visual flow builder) is served.
# Telegram requires HTTPS here — for local dev, point a tool like
# `cloudflared tunnel --url http://localhost:8080` at WEBAPP_PORT and paste
# the tunnel URL here (no trailing slash).
WEBAPP_URL=
WEBAPP_PORT=8080

# Video tutorial links shown alongside the (built-in, self-written) guide
# text on /start — one per language. Leave empty until you have them; the
# guide text still gets sent, just without the video button.
VIDEO_URL_FA=
VIDEO_URL_EN=

# The platform's OWN payment credentials for /live plans (bot owners paying
# YOU to keep their bot live) — separate from a bot owner's own shop payment
# settings, which each owner enters themselves in the Shop chat tool. Leave
# any of these empty until you have them; that payment method just won't be
# offered yet. Iranian bot creators only ever see Zarinpal; everyone else
# sees TON and Card (Visa/Mastercard via Stripe).
PLATFORM_ZARINPAL_MERCHANT_ID=
PLATFORM_STRIPE_SECRET_KEY=
PLATFORM_TON_WALLET_ADDRESS=

# easymakebot marketing website (the WordPress build in web/). Lets a user
# redeem a plan activation code they bought there, from inside /live.
# WEBSITE_URL: the site's base URL, no trailing slash (e.g. https://easymakebot.ir).
# WEBSITE_ACTIVATION_KEY: must match EMB_ACTIVATION_KEY in web/.env.
# Leave both empty to hide the "Activate with code" option.
WEBSITE_URL=https://easymakebot.com
WEBSITE_ACTIVATION_KEY=PfErwRopt76kq6epRkhVHCSh3lsEDJiVnMXEPXm
# Where an Iran-region owner is sent to BUY a plan (opens in their browser so
# the payment runs on the Iranian site with a native IP — a Telegram VPN
# breaks the gateway). Blank => "{WEBSITE_URL}/plans/".
WEBSITE_PLANS_URL=
# Only true if THIS bot server is on an Iran IP. Otherwise Iran owners buy on
# the website + redeem a code instead of an on-bot Zarinpal payment.
PLATFORM_ONBOT_ZARINPAL=false
