# ─────────────────────────────────────────────────────────────────────────────
# easymakebot website — environment
# Copy to .env and fill in. NEVER commit .env.
# Generate every password/secret with:  openssl rand -base64 24
# ─────────────────────────────────────────────────────────────────────────────

# --- Site identity -----------------------------------------------------------
# Local dev: http://localhost:8080   |   Staging: https://staging.example.com
WP_HOME=http://localhost:8080
WP_SITEURL=http://localhost:8080

# --- Database (MariaDB) ----------------------------------------------------
# The root password is only used to create the DB on first boot.
MARIADB_ROOT_PASSWORD=change-me-root
MARIADB_DATABASE=easymakebot_wp
MARIADB_USER=emb_wp
MARIADB_PASSWORD=change-me-db
# Non-default table prefix (hardening). Keep the trailing underscore.
WP_TABLE_PREFIX=emb_

# --- WordPress salts -------------------------------------------------------
# Paste a fresh set from https://api.wordpress.org/secret-key/1.1/salt/
# (all 8 lines, keep the define(...) syntax) — used via WORDPRESS_CONFIG_EXTRA.
# Leave the placeholder for local dev; MUST be real for staging/production.
WP_AUTH_KEY=put-real-salt
WP_SECURE_AUTH_KEY=put-real-salt
WP_LOGGED_IN_KEY=put-real-salt
WP_NONCE_KEY=put-real-salt
WP_AUTH_SALT=put-real-salt
WP_SECURE_AUTH_SALT=put-real-salt
WP_LOGGED_IN_SALT=put-real-salt
WP_NONCE_SALT=put-real-salt

# --- Redis object cache --------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# --- First-run admin (used by scripts/install.sh only) ------------------
WP_ADMIN_USER=embadmin
WP_ADMIN_PASSWORD=change-me-admin
WP_ADMIN_EMAIL=you@example.com
WP_TITLE=easymakebot

# --- Outgoing mail ------------------------------------------------------
# Local dev routes to Mailpit (http://localhost:8025) automatically.
# Staging/production: set real SMTP here and configure the SMTP plugin.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@example.com

# --- Off-site backups (scripts/backup.sh, prod only) -------------------
# An rclone remote name you have configured, plus the bucket/path.
RCLONE_REMOTE=b2:easymakebot-backups
BACKUP_KEEP_DAYS=30

# Shared secret for the plan activation-code REST API. Generate a long random
# string; put the SAME value in the bot .env as WEBSITE_ACTIVATION_KEY.
EMB_ACTIVATION_KEY=change-me-to-a-long-random-string

# --- SMS OTP for Iranian account verification (mu-plugin emb-accounts.php) ---
# Leave EMB_SMS_DRIVER=log until the Kavenegar account is verified and the OTP
# template ("verify/lookup") is approved; then set it to "kavenegar" and fill
# the key + template (or enter them in wp-admin > Settings > easymakebot).
# With the "log" driver the code is written to wp-content/uploads/emb-sms.log.
EMB_SMS_DRIVER=log
EMB_SMS_API_KEY=
EMB_SMS_TEMPLATE=
